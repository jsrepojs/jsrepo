{
	"name": "@example/svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n registry,app -c \"blue,green\" \"pnpm registry:dev\" \"vite dev\"",
		"build": "pnpm build:registry && vite build",
		"preview": "pnpm build:registry && vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"registry:build": "jsrepo build",
		"registry:dev": "jsrepo build --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"clsx": "^2.1.1",
		"concurrently": "catalog:",
		"jsrepo": "workspace:*",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
